    isMisleading: 0
    triggerOnWrongSlotId: 
    triggerOnCorrectSlotId: 
    triggerOnDrawerId: mirror-secret
  - id: msg-09-third-drawer-trap
    text: Don't open the third drawer. It's trapped and will reset everything.
    isMisleading: 1
    triggerOnWrongSlotId: 
    triggerOnCorrectSlotId: 
    triggerOnDrawerId: 
  - id: msg-10-ghost-not-real
